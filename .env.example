# Скопируйте этот файл в .env и укажите свои значения

# Секрет для подписи JWT-токенов — задайте случайную длинную строку
JWT_SECRET=change-this-to-a-random-secret-string

# Пароль администратора, который создаётся при первом запуске (логин: admin)
ADMIN_PASSWORD=admin123

# Порт, на котором запускается сервер
PORT=3000
